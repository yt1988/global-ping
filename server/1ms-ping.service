# 1ms-ping: Global Ping's server. Copy to /etc/systemd/system/ and change the placeholders: <user>, <app>, <public-ip>
# (behind NAT, not on an interface), <api-domain> and <page-domain>. The binary goes to /opt/<app>/1ms-ping; it needs
# CAP_NET_RAW for ICMP and nothing else. The certificate is renewed by certbot, which must then restart this service.
[Unit]
Description=1ms-ping: Global Ping's server (the Tokyo view)
After=network-online.target
Wants=network-online.target

[Service]
User=<user>
Group=<user>
# -self: the machine's public IPv4, if it is behind the cloud's NAT and not on an interface, so it is refused
ExecStart=/opt/<app>/1ms-ping -addr :2097 -self <public-ip> -origin https://<page-domain>
LoadCredential=fullchain.pem:/etc/letsencrypt/live/<api-domain>/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/<api-domain>/privkey.pem
Restart=on-failure
RestartSec=5

# resources
Environment=GOMEMLIMIT=48MiB
MemoryMax=64M
TasksMax=64
LimitNOFILE=4096

# no access log: the program writes nothing but a fatal error, and only errors reach the journal
StandardOutput=null
StandardError=journal
LogLevelMax=err

# ICMP needs CAP_NET_RAW; everything else is dropped
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes

# The program refuses private, reserved and its own addresses; this is the same again, enforced by the kernel for every
# packet the service sends or receives (remote addresses only, so visitors and public resolvers pass). Add the
# machine's own public IPv4 and IPv6 at the end.
IPAddressDeny=localhost link-local multicast 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 240.0.0.0/4 ::/96 ::ffff:0:0/96 64:ff9b::/96 2001:db8::/32 2002::/16 fc00::/7 fec0::/10

# hardening: nothing writable, no extra privileges
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=077

[Install]
WantedBy=multi-user.target
